{
  "name": "openclaw-flowspeech",
  "version": "0.1.0",
  "description": "FlowSpeech text-to-speech provider plugin for OpenClaw.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build && npm test"
  },
  "keywords": [
    "openclaw",
    "flowspeech",
    "text-to-speech",
    "tts",
    "ai-voice"
  ],
  "homepage": "https://flowspeech.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waeckerlinfederowicz66-sketch/openclaw-flowspeech.git"
  },
  "bugs": {
    "url": "https://github.com/waeckerlinfederowicz66-sketch/openclaw-flowspeech/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "openclaw": ">=2026.6.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.7.1-2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "clawhubSpec": "clawhub:openclaw-flowspeech",
      "npmSpec": "openclaw-flowspeech",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.6.8"
    },
    "compat": {
      "pluginApi": ">=2026.6.8",
      "minGatewayVersion": ">=2026.6.8"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
